#!/usr/bin/env bash
# Docs-alignment check: verify the modular docs (docs/ + README landing pages)
# still describe the actual code (hook commands, lints, toolchain, edition,
# justfile recipes, mirrors, CI, release).
# Covers greppable invariants only; semantic alignment stays with the agent/human.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

errors=0
fail() {
  echo "  FAIL  $*" >&2
  errors=$((errors + 1))
}

expect() {
  # expect <description> <file> <fixed-string-pattern>
  local desc="$1" file="$2" pattern="$3"
  if grep -qF -- "$pattern" "$file"; then
    echo "  ok    $desc"
  else
    echo "  FAIL  $desc -> missing '$pattern' in $file" >&2
    errors=$((errors + 1))
  fi
}

# 1) every gate command a hook runs must be documented in the checks docs
for hook in githooks/pre-commit githooks/pre-push githooks/pre-tag; do
  if [ ! -f "$hook" ]; then
    fail "$hook missing (see docs/checks.md)"
    continue
  fi
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    expect "[$hook] command documented in docs/checks.md: $cmd" docs/checks.md "$cmd"
    expect "[$hook] command documented in docs/checks.zh.md: $cmd" docs/checks.zh.md "$cmd"
  done < <(sed -e 's/[[:space:]]*#.*$//' "$hook" \
             | grep -oE '(cargo [a-z-]+|githooks/[a-z-]+)' \
             | sort -u)
done

# 1b) the reverse direction: every gate a checks page presents as a command
#     must still exist in a hook. Without this a gate can be deleted while its
#     documentation keeps claiming it runs.
for doc in docs/checks.md docs/checks.zh.md; do
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    found=0
    for hook in githooks/pre-commit githooks/pre-push githooks/pre-tag; do
      if grep -qF -- "$cmd" "$hook" 2>/dev/null; then
        found=1
        break
      fi
    done
    if [ "$found" -eq 1 ]; then
      echo "  ok    $doc: documented gate still exists: $cmd"
    else
      fail "$doc documents a gate no hook runs: $cmd"
    fi
  done < <(awk '
             /^## / { in_gate = ($0 ~ /pre-commit|pre-push|pre-tag/); next }
             in_gate { print }
           ' "$doc" \
             | grep -oE "\`(cargo [a-z-]+|githooks/[a-z-]+)[^\`]*\`" \
             | tr -d '`' | sort -u)
done

# 2) every lint declared in Cargo.toml [lints] must be documented in the lint-policy docs
while IFS= read -r lint; do
  [ -n "$lint" ] || continue
  expect "lint documented: $lint" docs/lint-policy.md '`'"$lint"'`'
  expect "lint documented: $lint" docs/lint-policy.zh.md '`'"$lint"'`'
done < <(awk '/^\[lints\./{f=1;next} /^\[/{f=0}
              # comments are prose, not lint declarations: a `=` inside one
              # (e.g. a code sample) is not a lint level
              f && /=/ && $0 !~ /^[ \t]*#/ {
                split($0,a,"="); k=a[1]; gsub(/[ \t]/,"",k); if (k != "") print k
              }' Cargo.toml)

# 3) rustc edition
edition=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml)
if [ -n "$edition" ]; then
  expect "edition documented: $edition" README.md "${edition} edition"
  expect "edition documented: $edition" README.zh.md "${edition} edition"
fi

# 4) toolchain channel
channel=$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)
if [ -n "$channel" ]; then
  expect "toolchain channel documented: $channel" README.md "channel = \"$channel\""
  expect "toolchain channel documented: $channel" README.zh.md "channel = \"$channel\""
fi

# 5) justfile recipes documented on the landing pages
expect "just setup documented" README.md 'just setup'
expect "just setup documented" README.zh.md 'just setup'
expect "just check documented" README.md 'just check'
expect "just check documented" README.zh.md 'just check'

# 5b) every backticked `just <recipe>` a live page cites must name a recipe the
#     justfile defines. Backticks keep prose ("just the", "just a") out of the
#     check, and the list comes from the justfile itself, so a rename that
#     leaves a page behind fails here instead of dead-ending a reader.
recipes=$(sed -n 's/^\([a-z][a-z0-9-]*\)\( .*\)\{0,1\}:.*/\1/p' justfile | sort -u)
while IFS= read -r recipe; do
  [ -n "$recipe" ] || continue
  if printf '%s\n' "$recipes" | grep -qx -- "$recipe"; then
    echo "  ok    just recipe exists: $recipe"
  else
    fail "a live page cites 'just $recipe', which the justfile does not define"
  fi
done < <(grep -rhoE '`just [a-z][a-z0-9-]*' README.md README.zh.md docs/*.md \
           | sed 's/^`just //' | sort -u)

# 6) hooks activation instruction
expect "hooksPath instruction documented" README.md 'core.hooksPath githooks'
expect "hooksPath instruction documented" README.zh.md 'core.hooksPath githooks'

# 7) docs gate itself must stay documented in the checks docs
expect "docs gate documented" docs/checks.md 'githooks/check-docs'
expect "docs gate documented" docs/checks.zh.md 'githooks/check-docs'

# 8) READMEs must link every modular docs page (index integrity, per language)
while IFS= read -r page; do
  name="$(basename "$page")"
  case "$name" in
    *.zh.md) continue ;;
  esac
  expect "README links docs/$name" README.md "docs/$name"
  expect "README.zh links docs/${name%.md}.zh.md" README.zh.md "docs/${name%.md}.zh.md"
done < <(git ls-files 'docs/*.md')

# 8b) every page keeps a Chinese mirror, and the mirror keeps the same heading
#     structure. Translated text differs, so the comparison is the level
#     sequence, not the words: a section added to one language only is the
#     usual way a mirror drifts.
heading_levels() {
  awk '
    /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
    !fence && /^#+[[:space:]]/ { match($0, /^#+/); print RLENGTH }
  ' "$1"
}

check_pair() {
  local en="$1" zh="$2" en_levels zh_levels count
  en_levels="$(heading_levels "$en")"
  zh_levels="$(heading_levels "$zh")"
  if [ "$en_levels" = "$zh_levels" ]; then
    count="$(printf '%s\n' "$en_levels" | awk 'NF { n++ } END { print n+0 }')"
    echo "  ok    $en and $zh have the same heading structure ($count headings)"
  else
    fail "$en and $zh have different heading structure — the mirror drifted"
    printf '        en: %s\n' "$(printf '%s' "$en_levels" | tr '\n' ' ')" >&2
    printf '        zh: %s\n' "$(printf '%s' "$zh_levels" | tr '\n' ' ')" >&2
  fi
}

if [ -f README.md ] && [ -f README.zh.md ]; then
  check_pair README.md README.zh.md
else
  fail "README.md / README.zh.md pair missing"
fi

while IFS= read -r page; do
  case "$page" in
    *.zh.md) continue ;;
  esac
  zh="${page%.md}.zh.md"
  if [ ! -f "$zh" ]; then
    fail "$page has no Chinese mirror ($zh)"
  else
    check_pair "$page" "$zh"
  fi
done < <(git ls-files 'docs/*.md')

while IFS= read -r zh; do
  base="${zh%.zh.md}.md"
  if [ ! -f "$base" ]; then
    fail "$zh has no base page ($base)"
  fi
done < <(git ls-files 'docs/*.zh.md')

# 9) CI runs the deterministic gates, platform tests and meta-lint
if [ -f .github/workflows/ci.yml ]; then
  expect "CI uses the shared Rust setup" .github/workflows/ci.yml './.github/actions/rust-setup'
  expect "CI uses the shared Rust gates" .github/workflows/ci.yml './.github/actions/rust-gates'
  expect "CI scans the diff for secrets" .github/workflows/ci.yml 'githooks/check-secrets'
  expect "CI runs the docs gate" .github/workflows/ci.yml 'githooks/check-docs'
  expect "CI runs platform tests" .github/workflows/ci.yml 'cargo test --locked'
  expect "CI lints workflows" .github/workflows/ci.yml 'actionlint'
  expect "CI lints hooks" .github/workflows/ci.yml 'shellcheck -x githooks/* tests/check-docs.sh'
  expect "CI self-tests the docs gate" .github/workflows/ci.yml 'tests/check-docs.sh'
  if [ -f .github/actions/rust-gates/action.yml ]; then
    expect "Rust gates run the deterministic chain" .github/actions/rust-gates/action.yml 'just verify'
    expect "Rust gates build the release profile" .github/actions/rust-gates/action.yml 'just build-release'
    expect "Rust gates run the dependency policy" .github/actions/rust-gates/action.yml 'just deps'
    expect "Rust gates smoke-test the image" .github/actions/rust-gates/action.yml 'just image'
    expect "Rust gates install musl tools" .github/actions/rust-gates/action.yml 'musl-tools'
  else
    fail "shared Rust gates action missing"
  fi
else
  echo "  FAIL  .github/workflows/ci.yml missing (README badge references it)" >&2
  errors=$((errors + 1))
fi

# 10) release notes must be extracted from CHANGELOG.md
if [ -f .github/workflows/release.yml ]; then
  expect "release notes extracted from CHANGELOG" .github/workflows/release.yml 'CHANGELOG.md'
  expect "release docs mention CHANGELOG" docs/release.md 'CHANGELOG'
  expect "release docs mention CHANGELOG" docs/release.zh.md 'CHANGELOG'
else
  echo "  FAIL  .github/workflows/release.yml missing (see docs/release.md)" >&2
  errors=$((errors + 1))
fi

# 10c) release preflight and GHCR image
if [ -f Containerfile ]; then
  expect "release creates a draft first" .github/workflows/release.yml '--draft'
  expect "release publishes after artifacts" .github/workflows/release.yml '--draft=false'
  expect "release pushes a GHCR image" .github/workflows/release.yml 'ghcr.io'
  expect "image recipe smoke-tests the binary" justfile 'Hello, world!'
  expect "release builds with the lockfile" .github/workflows/release.yml 'locked: true'
  expect "release uses the shared image recipe" .github/workflows/release.yml './.github/actions/rust-gates'
  expect "release labels the image source" .github/workflows/release.yml 'SOURCE_URL'
  expect "release sets GH_REPO for gh" .github/workflows/release.yml 'GH_REPO'
  expect "release handles prereleases" .github/workflows/release.yml '--prerelease'
  expect "release marks the latest release" .github/workflows/release.yml '--latest'
  expect "release verifies the tag" .github/workflows/release.yml '--verify-tag'
  expect "release plans from the target config" .github/workflows/release.yml '.github/targets.json'
  expect "release generates an SBOM" .github/workflows/release.yml 'cargo cyclonedx'
  expect "release attests its assets" .github/workflows/release.yml 'attest-build-provenance'
  expect "publish has a protected environment" .github/workflows/release.yml 'environment:'
  expect "target config builds static Linux x86_64" .github/targets.json 'x86_64-unknown-linux-musl'
  expect "target config builds static Linux arm64" .github/targets.json 'aarch64-unknown-linux-musl'
  expect "target config builds Intel macOS" .github/targets.json 'x86_64-apple-darwin'
  expect "release docs mention SBOM" docs/release.md 'SBOM'
  expect "release docs mention SBOM (zh)" docs/release.zh.md 'SBOM'
  expect "release docs mention attestation" docs/release.md 'attestation'
  expect "release docs mention attestation (zh)" docs/release.zh.md 'attestation'
  expect "release docs mention the release environment" docs/release.md 'release environment'
  expect "release docs mention the release environment (zh)" docs/release.zh.md 'release environment'
  expect "release docs mention Containerfile" docs/release.md 'Containerfile'
  expect "release docs mention Containerfile (zh)" docs/release.zh.md 'Containerfile'
  expect "release docs mention GHCR" docs/release.md 'GHCR'
  expect "release docs mention GHCR (zh)" docs/release.zh.md 'GHCR'
  expect "release docs mention just image" docs/release.md 'just image'
  expect "release docs mention just image (zh)" docs/release.zh.md 'just image'
  expect "Containerfile labels its source" Containerfile 'org.opencontainers.image.source'
  expect "release profile uses thin LTO" Cargo.toml 'lto = "thin"'
  expect "release profile aborts on panic" Cargo.toml 'panic = "abort"'
  expect "release profile strips symbols" Cargo.toml 'strip = "symbols"'
  expect "release profile documented" docs/checks.md 'LTO/panic=abort/strip'
  expect "release profile documented (zh)" docs/checks.zh.md 'LTO/panic=abort/strip'
else
  echo "  FAIL  Containerfile missing (release image)" >&2
  errors=$((errors + 1))
fi

# 10b) CHANGELOG skeleton: the file keeps the shape the release gates rely on,
#      so a broken heading is caught on an ordinary commit, not at tag time.
expect "CHANGELOG title" CHANGELOG.md '# Changelog'
expect "CHANGELOG keeps an Unreleased section" CHANGELOG.md '## [Unreleased]'
expect "CHANGELOG follows Keep a Changelog" CHANGELOG.md 'Keep a Changelog'
expect "CHANGELOG uses Semantic Versioning" CHANGELOG.md 'Semantic Versioning'
unreleased_sections="$(grep -c '^## \[Unreleased\]' CHANGELOG.md || true)"
if [ "${unreleased_sections:-0}" -eq 1 ]; then
  echo "  ok    CHANGELOG has exactly one '## [Unreleased]' section"
else
  fail "CHANGELOG.md needs exactly one '## [Unreleased]' section, found ${unreleased_sections:-0}"
fi
bad_dates="$(grep -E '^## \[[0-9]+\.[0-9]+\.[0-9]+\]' CHANGELOG.md \
  | grep -vE ' - [0-9]{4}-[0-9]{2}-[0-9]{2}$' || true)"
if [ -z "$bad_dates" ]; then
  echo "  ok    every version section in CHANGELOG.md is dated"
else
  fail "CHANGELOG.md has a version section without a date: $bad_dates"
fi

# 11) CD test builds: manual dispatch only, never a release, documented
if [ -f .github/workflows/test-build.yml ]; then
  expect "test builds are manual (workflow_dispatch)" .github/workflows/test-build.yml 'workflow_dispatch'
  expect "test builds read the target config" .github/workflows/test-build.yml '.github/targets.json'
  expect "test builds use the static Linux target" .github/targets.json 'x86_64-unknown-linux-musl'
  expect "test builds documented" docs/release.md 'test-build.yml'
  expect "test builds documented" docs/release.zh.md 'test-build.yml'
else
  echo "  FAIL  .github/workflows/test-build.yml missing (see AGENTS.md §6)" >&2
  errors=$((errors + 1))
fi

# 12) HANDOFF.md: agent-facing state notes exist and are referenced
if [ -f HANDOFF.md ]; then
  expect "README links HANDOFF.md" README.md 'HANDOFF.md'
  expect "README links HANDOFF.md" README.zh.md 'HANDOFF.md'
  expect "AGENTS.md references HANDOFF.md" AGENTS.md 'HANDOFF.md'
else
  echo "  FAIL  HANDOFF.md missing (AGENTS.md points to it for working state)" >&2
  errors=$((errors + 1))
fi

# 13) secret scan gate wired into the chain and documented
if [ -f githooks/check-secrets ]; then
  expect "secret scan gate wired" githooks/pre-commit 'githooks/check-secrets'
  expect "secret scan documented" docs/checks.md 'githooks/check-secrets'
  expect "secret scan documented" docs/checks.zh.md 'githooks/check-secrets'
else
  echo "  FAIL  githooks/check-secrets missing (AGENTS.md §9 secrets discipline)" >&2
  errors=$((errors + 1))
fi

# 15) scheduled security workflow
if [ -f .github/workflows/security.yml ]; then
  expect "scheduled security runs cargo audit" .github/workflows/security.yml 'cargo audit'
  expect "scheduled security runs cargo deny" .github/workflows/security.yml 'cargo deny check'
  expect "security docs mention cargo audit" docs/checks.md 'cargo audit'
  expect "security docs mention cargo audit (zh)" docs/checks.zh.md 'cargo audit'
  expect "security docs mention cargo deny" docs/checks.md 'cargo deny check'
  expect "security docs mention cargo deny (zh)" docs/checks.zh.md 'cargo deny check'
else
  echo "  FAIL  .github/workflows/security.yml missing (scheduled audit)" >&2
  errors=$((errors + 1))
fi

# 14) pre-tag release review: wired into pre-push and documented
if [ -f githooks/pre-tag ]; then
  expect "pre-tag review wired" githooks/pre-push 'githooks/pre-tag'
  expect "pre-tag documented" docs/checks.md 'githooks/pre-tag'
  expect "pre-tag documented" docs/checks.zh.md 'githooks/pre-tag'
  expect "pre-tag review in AGENTS.md" AGENTS.md 'githooks/pre-tag'
else
  echo "  FAIL  githooks/pre-tag missing (light release review, see AGENTS.md §5)" >&2
  errors=$((errors + 1))
fi

# soft notice: placeholders are expected in the template repo itself
if grep -qF '{{' README.md README.zh.md; then
  echo "  note: {{...}} placeholders still present (normal for this template repo)"
fi

if [ "$errors" -eq 0 ]; then
  echo "  docs alignment ok"
else
  echo "  $errors docs alignment issue(s) found" >&2
  exit 1
fi
