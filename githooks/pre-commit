#!/usr/bin/env bash
# Pre-commit hook (fast gates): format + secret scan + unused deps + docs-sync + strict clippy.
# A change limited to markdown, docs/ or assets/ cannot move the code gates, so
# it runs only the two gates it CAN break (the secret scan and the
# docs-alignment check) — the same split CI makes for the docs-only path.
# Heavyweight gates (audit / deny / test) live in githooks/pre-push;
# the release review lives in githooks/pre-tag.
# Activate via: git config core.hooksPath githooks   (or: just setup)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only --diff-filter=ACMRD | githooks/docs-only; then
  echo "==> docs-only change: skipping the code gates (fmt / machete / clippy)"
  echo "==> secret scan (githooks/check-secrets)"
  githooks/check-secrets
  echo "==> docs alignment (githooks/check-docs)"
  githooks/check-docs
  echo "pre-commit checks passed (docs-only)"
  exit 0
fi

echo "==> cargo fmt --check"
cargo fmt --all -- --check

echo "==> secret scan (githooks/check-secrets)"
githooks/check-secrets

echo "==> cargo machete (unused dependencies)"
cargo machete

echo "==> docs alignment (githooks/check-docs)"
githooks/check-docs

echo "==> cargo clippy (strict lints from Cargo.toml)"
cargo clippy --all-targets --all-features -- -D warnings

echo "pre-commit checks passed"
